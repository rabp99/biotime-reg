# ---------------------------------------------------------------------------
# Base de datos: la misma que usa BioTime hoy.
# ---------------------------------------------------------------------------
PG_DSN=postgresql://usuario:clave@127.0.0.1:5432/biotime

# ---------------------------------------------------------------------------
# Servidor
#
# El puerto DEBE ser 83: los 4 terminales lo tienen grabado en su configuración
# y Horario360 lo tiene en su ZKTECO_API_URL. Cambiarlo obliga a tocar ambos.
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=83

# API de consulta, en puerto propio.
#
# Horario360 corre en otro servidor, así que el API escucha en todas las
# interfaces. Como el host tiene IP pública, eso deja el endpoint de
# credenciales alcanzable desde internet salvo que se restrinja. DOS barreras:
#
#   1. Firewall     → deploy\configure-firewall.ps1 -Horario360Ip 161.132.68.120
#   2. API_ALLOWED_IPS (abajo) → la aplicación rechaza cualquier otro origen
#
# La segunda existe para que perder la regla del firewall no abra el endpoint.
# Dejar API_ALLOWED_IPS vacío desactiva la comprobación: solo para desarrollo.
#
# Recuerda actualizar ZKTECO_API_URL en el .env de Horario360 a:
#   http://161.132.55.79:8083/
API_HOST=0.0.0.0
API_PORT=8083
API_ALLOWED_IPS=161.132.68.120

# ---------------------------------------------------------------------------
# Zonas horarias
#
# DEVICE_TZ_FALLBACK: offset en horas a aplicar cuando un terminal no está aún
# registrado en iclock_terminal. Los equipos envían su hora local sin decir en
# qué zona están; sin esta conversión las marcaciones quedan desplazadas.
# Para los equipos ya registrados se usa iclock_terminal.terminal_tz (hoy: -5).
#
# API_RENDER_TZ: zona en la que el API devuelve punch_time como cadena plana,
# replicando el comportamiento de BioTime. Verificar contra el BioTime actual
# antes del corte (ver README).
# ---------------------------------------------------------------------------
DEVICE_TZ_FALLBACK=-5
API_RENDER_TZ=America/Lima

# ---------------------------------------------------------------------------
# Ingesta
#
# ALLOWED_SNS: lista separada por comas de los SN aceptados. Vacío = acepta
# cualquiera. Con la lista puesta, un desconocido no puede inyectar marcaciones.
# ALLOWED_SOURCE_IPS: IPs públicas de las sedes. Vacío = sin restricción.
#   190.119.162.162 = sede principal (BIO_05, BIO_06, BIO_07)
#   38.56.214.116   = sede secundaria (BIO_08)
# ---------------------------------------------------------------------------
ALLOWED_SNS=VDE2251700404,VDE2251700405,VDE2251700406,VDE2251700310
ALLOWED_SOURCE_IPS=
COMPANY_CODE=1
STORE_RAW_BODIES=true

# Opciones del handshake. Se envían al terminal en GET /iclock/cdata?options=all.
# TransFlag controla qué tablas empuja el equipo; si algún firmware deja de
# enviar datos, este es el primer valor a ajustar.
HANDSHAKE_TRANS_FLAG=TransData AttLog OpLog AttPhoto EnrollUser ChgUser EnrollFP ChgFP FPImag
HANDSHAKE_TRANS_INTERVAL=1
HANDSHAKE_TIMEZONE=-5
HANDSHAKE_REALTIME=1

# ---------------------------------------------------------------------------
# API de consulta (Horario360)
#
# JWT_SECRET: firma los tokens emitidos por /jwt-api-token-auth/.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
JWT_SECRET=cambiar-por-un-valor-aleatorio-largo
JWT_TTL_HOURS=24
API_DEFAULT_PAGE_SIZE=100
API_MAX_PAGE_SIZE=5000

LOG_LEVEL=INFO
